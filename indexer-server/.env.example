# ── IndexerRegistry node config (job #259) ──

# Base mainnet RPC. Public works for testing; use Alchemy/Infura in production
# (the public RPC rate-limits eth_getLogs hard, and the watcher backfills 7d).
BASE_RPC_URL=https://mainnet.base.org

# Submits settleQuery txs and pays their gas. settleQuery is permissionless, so
# this can (and should) be a throwaway wallet holding ONLY a little ETH — if
# the host is compromised you lose gas money, not the indexer stake.
SUBMITTER_PRIVATE_KEY=0x...

# The wallet that registered (CLAWD, Transfer) on-chain via `npm run register`.
# The 98% indexer fee share is paid here. Address only — no key needed.
INDEXER_ADDRESS=0x...

# The deployed IndexerRegistry contract on Base.
INDEXER_CONTRACT=0x3be578A72d1c4ffDBB2AA2418a7fb749BCDBA313

# Price per Clickable Question, USDC base units (6 decimals). 100000 = $0.10.
QUESTION_FEE=100000

# Price per raw /query call. 10000 = $0.01 (the on-chain MIN_QUERY_FEE).
QUERY_FEE=10000

# 1 = submit settleQuery on-chain after answering (consumer must have approved
# USDC to the contract). 0 = serve answers without settling (local testing).
SETTLE_ONCHAIN=0

# Watcher backfill depth in blocks. 302400 ≈ 7 days on Base.
BACKFILL_BLOCKS=302400

# HTTP port. Railway injects PORT automatically; this is the local default.
PORT=8080
